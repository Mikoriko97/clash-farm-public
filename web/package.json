{
  "name": "clash-farm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "build:admin": "tsc -p tsconfig.json && vite build --config vite.admin.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "design": "vite --config vite.design.config.ts",
    "design:mock": "node design-preview/mock-api.mjs",
    "design:shoot": "node design-preview/shoot.mjs",
    "smoke": "node e2e/smoke.mjs",
    "audit:ci": "node scripts/audit-ci.mjs"
  },
  "dependencies": {
    "@solana-mobile/wallet-standard-mobile": "0.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "buffer": "6.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
